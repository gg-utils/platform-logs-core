{
  "name": "@gg-utils/platform-logs-core",
  "version": "0.2.0",
  "description": "Product-neutral platform log discovery, budget, validation, and tail process primitives.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./discover-log-files": {
      "types": "./dist/discover-log-files.d.ts",
      "default": "./dist/discover-log-files.js"
    },
    "./parse-env-number": {
      "types": "./dist/parse-env-number.d.ts",
      "default": "./dist/parse-env-number.js"
    },
    "./tail-process": {
      "types": "./dist/tail-process.d.ts",
      "default": "./dist/tail-process.js"
    },
    "./tokens-to-char-budget": {
      "types": "./dist/tokens-to-char-budget.d.ts",
      "default": "./dist/tokens-to-char-budget.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0 <27",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"src/**/*.unit.test.ts\"",
    "lint": "eslint --max-warnings 0 .",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gg-utils/platform-logs-core.git"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
